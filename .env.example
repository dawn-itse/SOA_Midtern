# Biến cho docker-compose (không bắt buộc: không có biến nào vẫn chạy bằng Mailpit)
# --- Mail: mặc định Mailpit (http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# --- Gmail thật: ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=<gmail gửi>
# SMTP_PASS=<App Password 16 ký tự, không khoảng trắng>
MAIL_TO_OVERRIDE=

# --- Bảo mật (Đợt 2): giá trị mặc định dành cho đồ án, đổi nếu triển khai thật ---
# JWT_SECRET: ký/kiểm tra token đăng nhập. INTERNAL_API_SECRET: header x-internal-secret giữa các service.
JWT_SECRET=soa_midterm_secret
INTERNAL_API_SECRET=soa_internal_secret
