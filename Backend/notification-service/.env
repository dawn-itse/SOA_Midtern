DB_PORT=3306
DB_USER=notification_user
DB_PASSWORD=notification_pass
DB_NAME=notification_db
# Mặc định: Mailpit (xem mail tại http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Gmail thật (bỏ comment và comment 2 dòng Mailpit ở trên) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=<gmail gửi>
# SMTP_PASS=<App Password của gmail gửi, 16 ký tự không khoảng trắng>
# MAIL_TO_OVERRIDE=<email nhận OTP>

# Bí mật dùng chung giữa các service: notification chỉ nhận request nội bộ có header x-internal-secret
INTERNAL_API_SECRET=soa_internal_secret
